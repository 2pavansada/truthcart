# =============================================================================
# TruthCart AI -- Environment Variables Template
# =============================================================================
# Optional settings below are read from the process environment. The app does
# not load .env files itself; configure your shell or process manager.
#
# No external API keys are used. Authentication settings can be supplied here.
#
# If you add external services in future iterations, document them here:
# =============================================================================

# For a TLS-terminating reverse proxy, set this to true so auth cookies remain
# Secure even when the application server receives plain HTTP from the proxy.
# Local HTTP development uses false (the config default).
# TRUTHCART_AUTH_COOKIE_SECURE=true
# TRUTHCART_AUTH_SESSION_TTL_SECONDS=604800
# TRUTHCART_AUTH_CSRF_TTL_SECONDS=900
# TRUTHCART_AUTH_DB_PATH=data/build/truthcart_auth.sqlite
# TRUTHCART_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
